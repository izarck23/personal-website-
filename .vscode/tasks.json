{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "label": "Start Dev Server (npm run dev)",
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "build",
      "label": "Production Build (npm run build)",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "type": "npm",
      "script": "lint",
      "label": "Type Check & Lint (npm run lint)",
      "problemMatcher": ["$tsc"]
    },
    {
      "type": "npm",
      "script": "preview",
      "label": "Preview Production Build (npm run preview)"
    }
  ]
}
